# Kwipu Local Configuration Example
KWIPU_ROOT_DIR=.
KWIPU_KNOWLEDGE_DIR=knowledge_base
KWIPU_STORAGE_DIR=storage_graph
KWIPU_EMBED_MODEL=nomic-embed-text
KWIPU_LLM_MODEL=qwen2.5-coder:7b
KWIPU_OLLAMA_BASE_URL=http://localhost:11434
KWIPU_QUERY_MAX_LENGTH=4000

# Bridge Settings
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BRIDGE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
